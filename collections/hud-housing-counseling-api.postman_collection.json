          "id": "4f8223ba-db04-4aee-a217-6511d663b976",
          "name": "Search Housing Counseling Agencies by Location",
          "request": {
            "name": "Search Housing Counseling Agencies by Location",
            "description": {
              "content": "Search for HUD-approved housing counseling agencies near a specified geographic location (latitude/longitude) within a given distance radius. Returns agencies sorted by proximity to the search coordinates.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Housing_Counselor",
                "searchByLocation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "(Required) Latitude of the search center point (decimal degrees)"
                },
                {
                  "disabled": false,
                  "key": "long",
                  "value": "<double>",
                  "description": "(Required) Longitude of the search center point (decimal degrees)"
                },
                {
                  "disabled": false,
                  "key": "distance",
                  "value": "5",
                  "description": "Search radius in miles (default is typically 5 miles)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
