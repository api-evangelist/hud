            "description": {
              "content": "Search for HUD-approved housing counseling agencies by agency name, city, and/or state. Returns a list of agencies matching the search criteria with full contact and service information. No API key required.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Housing_Counselor",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "AgencyName",
                  "value": "<string>",
                  "description": "Full or partial agency name to search for"
                },
                {
                  "disabled": false,
                  "key": "City",
                  "value": "<string>",
                  "description": "City name to filter results"
                },
                {
                  "disabled": false,
                  "key": "State",
                  "value": "<string>",
                  "description": "Two-letter state abbreviation to filter results"
                }
              ],
              "variable": []
            },
