  "info": {
    "_postman_id": "934375ed-ac9d-4eb4-b744-2275cf6b0c4a",
    "name": "HUD User CHAS Housing Counseling API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Comprehensive Housing Affordability Strategy (CHAS) data provides custom tabulations of American Community Survey (ACS) data on housing needs at national, state, county, place, and census tract levels. CHAS data is used for Consolidated Planning submissions required to receive HUD formula grant funds. Requires a free bearer token obtained from the HUD User portal.\n\nContact Support:\n Name: HUD User Support",
      "type": "text/plain"
    }
  }
